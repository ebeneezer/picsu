[Unit]
Description=MQTT Snapshot Listener (picsu)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/picsu-snapshot.env
ExecStart=%h/picsu/picsu_snapshot_sub.pl
Restart=on-failure
RestartSec=1
KillMode=control-group
TimeoutStopSec=5

[Install]
WantedBy=default.target
